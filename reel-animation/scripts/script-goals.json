{
  "audio": "goals-voice.mp3",
  "phrases": [
    { "start": 0.12, "end": 2.97, "text": "بهترین راه برای اینکه هیچ‌وقت به هدفات نرسی،", "keys": ["هیچ‌وقت"] },
    { "start": 3.51, "end": 5.93, "text": "اینه که با همه درباره‌شون حرف بزنی.", "keys": ["همه"] },
    { "start": 6.78, "end": 9.47, "text": "هر بار که هدفتو با کسی در میون میذاری،", "keys": ["هدفتو"] },
    { "start": 9.80, "end": 11.38, "text": "یه حس خوب بهت دست میده،", "keys": ["حس", "خوب"] },
    { "start": 11.97, "end": 14.88, "text": "شبیه همونی که موقع رسیدن بهش تجربه می‌کنی.", "keys": ["رسیدن"] },
    { "start": 15.61, "end": 19.45, "text": "و همین باعث میشه انگیزه‌ت برای دنبال کردنش کمتر بشه.", "keys": ["کمتر"] },
    { "start": 20.19, "end": 20.96, "text": "از طرفی هم", "keys": [] },
    { "start": 21.45, "end": 24.45, "text": "داری رویاهاتو در معرض آدم‌های حسود قرار میدی.", "keys": ["حسود"] },
    { "start": 24.57, "end": 27.04, "text": "کسایی که از تخریب کردنشون لذت می‌برن.", "keys": ["تخریب"] },
    { "start": 27.69, "end": 29.57, "text": "وقتی تو به هدفات برسی،", "keys": ["برسی"] },
    { "start": 29.87, "end": 32.71, "text": "اونا نسبت به خودشون احساس ضعف و ناامنی می‌کنن.", "keys": ["ضعف", "ناامنی"] },
    { "start": 33.45, "end": 35.10, "text": "هدفتو برای خودت نگه دار.", "keys": ["خودت"] },
    { "start": 35.48, "end": 36.96, "text": "رسیدن بهش سخته.", "keys": ["سخته"] },
    { "start": 37.39, "end": 38.84, "text": "لازم نیست سخت‌ترش کنی.", "keys": ["سخت‌ترش"] }
  ]
}
